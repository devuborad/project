# Campus AI Production Environment Configuration

# Server Settings
PORT=5000
NODE_ENV=production

# Database Credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=campus_ai

# Security & Auth
JWT_SECRET=campus_ai_production_secret_jwt_key_2026
SESSION_SECRET=campus_ai_session_secret_2026

# Autonomous AI Agent API Settings
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiter
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_MS=60000
